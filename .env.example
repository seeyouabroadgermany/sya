# Copy to .env.local and fill in. Never commit .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# The address people use to open the CRM (used in emails and password links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: emails to counsellors (new lead assigned). Without these, the CRM works and skips emails.
# Resend > API Keys. Free tier is enough for a small team.
RESEND_API_KEY=re_...
# Must be an address on a domain you verified in Resend, e.g. "SYB CRM <crm@seeyouabroad.in>"
EMAIL_FROM=SYB CRM <crm@yourdomain.in>
